# Copy to `.env.local` when you connect live services.
# The app runs with zero of these set: database, Stripe, email, AI, and wallet stay in mock mode.

# Session signing. Required before a public production deploy. Mock mode uses a built-in development key.
SESSION_SECRET=

# Optional. Set to true behind HTTPS if your proxy does not send x-forwarded-proto.
COOKIE_SECURE=

# Seconds before a second stamp on the same card asks the staff to confirm. Default 90.
PUNCH_COOLDOWN_SECONDS=90

# Supabase. Use the publishable key or the legacy anon key. Service role stays on the server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe test mode. Webhook + service role applies the plan in Supabase.
# Without the webhook secret, the success page can still activate the plan for a test checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Optional email. Without a key, messages are stored in the super-admin outbox.
RESEND_API_KEY=
EMAIL_FROM=

# Optional reward copy. Pro plans call the provider that has a key. Groq wins if both are set.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Apple Wallet. All four are required before the Apple provider reports itself configured.
# This build still downloads an unsigned placeholder; WalletProvider is the signing seam.
APPLE_PASS_CERT_PEM=
APPLE_PASS_KEY_PEM=
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_WWDR_PEM=

# Google Wallet. Both are required before the Google provider reports itself configured.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
